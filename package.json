{
  "name": "pentimento",
  "version": "0.9.0",
  "description": "Living documents: one canonical markdown file, hidden revision history, deterministic HTML rendering",
  "license": "MIT",
  "author": "Lucas Traba",
  "type": "module",
  "engines": {
    "node": ">=20.13"
  },
  "bin": {
    "pentimento": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucastraba/pentimento.git"
  },
  "keywords": [
    "markdown",
    "revision-history",
    "versioning",
    "living-documents",
    "ai-agents",
    "plans",
    "html-renderer",
