    "assets",
    "skill",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepare": "tsc"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.8",
    "diff": "^9.0.0",
    "hono": "^4.12.29",
    "markdown-it": "^14.3.0",
    "sanitize-html": "2.17.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.1",
    "@types/sanitize-html": "^2.16.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "bugs": {
    "url": "https://github.com/lucastraba/pentimento/issues"
  },
  "homepage": "https://github.com/lucastraba/pentimento#readme"
}
